apiVersion: kafka.strimzi.io/v1beta2
kind: Kafka
metadata:
  name: {{ kafka_cluster_name }}
  namespace: {{ strimzi_namespace }}
spec:
  kafka:
    version: 3.5.0
    replicas: {{ kafka_replicas }}
    listeners:
      - name: plain
        port: {{ listener_internal_port }}
        type: internal
        tls: false
      - name: external
        port: {{ listener_external_port }}
        type: nodeport
        tls: false
        configuration:
          bootstrap:
            nodePort: {{ listener_external_port }}
    config:
      offsets.topic.replication.factor: 1
      transaction.state.log.replication.factor: 1
      transaction.state.log.min.isr: 1
      log.message.format.version: "3.0"
    storage:
      type: ephemeral
  zookeeper:
    replicas: {{ zookeeper_replicas }}
    storage:
      type: ephemeral
  entityOperator:
    topicOperator: {}
    userOperator: {}